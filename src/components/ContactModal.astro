---
import { CONTACT_EMAIL } from "../lib/site";

export interface Field {
  name: string;
  label: string;
  type?: string;
  placeholder?: string;
  required?: boolean;
  rows?: number;
}

export interface Props {
  triggerText?: string;
  triggerStyle?: string;
  /** Inline style for the trigger button (e.g. dark nav button). Replaces the dead triggerStyleOverride prop. */
  triggerButtonStyle?: string;
  title?: string;
  subtitle?: string;
  subject?: string;
  inputLabel?: string;
  inputPlaceholder?: string;
  calTitle?: string;
  calSubtitle?: string;
  calLink?: string;
  fields?: Field[];
  /** Stable id suffix when several modals share a page. */
  uid?: string;
}

const {
  triggerText = "Let's Talk",
  triggerStyle = "btn btn-primary",
  triggerButtonStyle = "",
  title = "Send a brief.",
  subtitle = "I typically reply within 2-4 hours.",
  subject = "New Project Inquiry via deepakj.dev",
  inputLabel = "Project Details",
  inputPlaceholder = "What are we building?",
  calTitle = "Ready to move fast?",
  calSubtitle = "Skip the email back-and-forth. Grab 15 minutes to see if we're a fit.",
  calLink = "deepslog/meet",
  fields,
  uid = Math.random().toString(36).slice(2, 8),
} = Astro.props;

const formFields: Field[] = fields ?? [
  { name: "name", label: "Name", type: "text", required: true },
  { name: "email", label: "Email", type: "email", required: true },
  {
    name: "message",
    label: inputLabel,
    type: "textarea",
    placeholder: inputPlaceholder,
    required: true,
  },
];
---

<span
  data-cm-root
  data-cm-subject={subject}
  data-cm-location={Astro.url.pathname}
  data-cm-callink={calLink}
  data-cm-mailto={CONTACT_EMAIL}
>
  <button class={triggerStyle} style={triggerButtonStyle} data-cm-open>
    {triggerText}
    <svg
      class="h-3.5 w-3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 5l7 7-7 7"></path>
    </svg>
  </button>

  <div data-cm-overlay hidden class="fixed inset-0 z-[9999] overflow-y-auto overscroll-none">
    <div
      data-cm-backdrop
      class="fixed inset-0 backdrop-blur-sm"
      style="background: rgba(23, 20, 15, 0.6)"
    ></div>

    <div class="flex min-h-full flex-col justify-center p-4 sm:p-8 relative">
      <div
        class="surface-inverted relative mx-auto my-auto flex w-full max-w-4xl animate-fade-in-up flex-col overflow-hidden border md:h-[600px] md:max-h-[85vh] md:flex-row"
        style="border-color: var(--color-ink-surface-line)"
        role="dialog"
        aria-modal="true"
        aria-label={title}
      >
        <button
          data-cm-close
          class="absolute top-3 right-4 z-30 p-2 transition-colors hover:text-(--color-ink-surface-text) cursor-pointer"
          style="color: var(--color-ink-surface-muted)"
          aria-label="Close dialog"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        {/* LEFT: form */}
        <div
          data-cm-left
          class="relative z-10 w-full flex-col justify-center overflow-y-auto border-b p-6 md:h-full md:w-1/2 md:border-b-0 md:border-r md:p-8 flex"
          style="border-color: var(--color-ink-surface-line)"
        >
          <div data-cm-success-view hidden class="flex h-full animate-fade-in-up flex-col items-center justify-center text-center">
            <svg
              class="mb-6 h-10 w-10"
              style="color: var(--color-status-live)"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <path d="M5 13l4 4L19 7"></path>
            </svg>
            <h3 style="color: var(--color-ink-surface-text)">Message Received</h3>
            <p
              class="stat-caption mt-3 max-w-[250px] normal-case tracking-normal"
              style="color: var(--color-ink-surface-muted)"
            >
              I&rsquo;ll review the details and get back to you shortly.
            </p>
          </div>

          <div data-cm-form-view>
            <h3 style="color: var(--color-ink-surface-text)">{title}</h3>
            <p
              class="stat-caption mt-2 mb-6 normal-case tracking-normal"
              style="color: var(--color-ink-surface-muted)"
            >
              {subtitle}
            </p>

            <form data-cm-form class="space-y-4" novalidate={false}>
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

              {formFields.map((field) => (
                <div>
                  <label
                    class="stat-caption mb-2 block"
                    style="color: var(--color-ink-surface-muted)"
                    for={`cm-${uid}-${field.name}`}
                  >
                    {field.label}
                    {field.required === false && <span class="normal-case"> (optional)</span>}
                  </label>
                  {field.type === "textarea" ? (
                    <textarea
                      id={`cm-${uid}-${field.name}`}
                      required={field.required !== false}
                      name={field.name}
                      rows={field.rows || 3}
                      class="w-full border px-4 py-3 outline-none transition-colors resize-none"
                      style="background: var(--color-ink); border-color: var(--color-ink-surface-line); color: var(--color-ink-surface-text); font-size: var(--text-body-md)"
                      placeholder={field.placeholder}
                    ></textarea>
                  ) : (
                    <input
                      id={`cm-${uid}-${field.name}`}
                      required={field.required !== false}
                      type={field.type || "text"}
                      name={field.name}
                      placeholder={field.placeholder}
                      class="w-full border px-4 py-3 outline-none transition-colors"
                      style="background: var(--color-ink); border-color: var(--color-ink-surface-line); color: var(--color-ink-surface-text); font-size: var(--text-body-md)"
                    />
                  )}
                </div>
              ))}

              <div
                data-cm-error
                hidden
                class="flex items-start gap-2 border-l-2 py-2 pl-3"
                style="border-color: var(--color-accent-dim); color: var(--color-ink-surface-muted); font-size: var(--text-body-sm)"
                role="alert"
              >
                <span>
                  Something went wrong on my end. Try again, or email me directly at{" "}
                  <a data-cm-error-mailto href={`mailto:${CONTACT_EMAIL}`} style="text-decoration: underline">
                    {CONTACT_EMAIL}
                  </a>.
                </span>
              </div>

              <div
                data-cm-nokey
                hidden
                class="border-l-2 py-2 pl-3"
                style="border-color: var(--color-accent-dim); color: var(--color-ink-surface-muted); font-size: var(--text-body-sm)"
                role="note"
              >
                <span>
                  The form is temporarily offline — email me directly at{" "}
                  <a href={`mailto:${CONTACT_EMAIL}`} style="text-decoration: underline">{CONTACT_EMAIL}</a>.
                </span>
              </div>

              <button type="submit" data-cm-submit class="btn btn-primary mt-2 w-full disabled:opacity-50 disabled:cursor-not-allowed">
                Send Message
              </button>
            </form>
          </div>
        </div>

        {/* RIGHT: calendar */}
        <div
          class="relative z-10 flex w-full flex-col items-center justify-center md:h-full md:w-1/2 md:p-8 p-6 text-center"
          style="background: var(--color-ink)"
        >
          <div data-cm-cal-pane hidden class="absolute inset-0 flex flex-col overflow-hidden bg-white">
            <div class="flex items-center border-b p-4 md:hidden" style="background: var(--color-paper)">
              <button data-cm-cal-back class="ui-text flex items-center gap-1.5">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <path d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back
              </button>
            </div>
            <div data-cm-cal class="grow w-full h-full overflow-y-auto overscroll-contain" style="min-height: 420px"></div>
          </div>

          <svg
            class="mb-5 h-6 w-6"
            style="color: var(--color-accent-dim)"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <h3 style="color: var(--color-ink-surface-text)">{calTitle}</h3>
          <p
            class="stat-caption mt-3 mb-6 max-w-xs normal-case tracking-normal"
            style="color: var(--color-ink-surface-muted)"
          >
            {calSubtitle}
          </p>
          <button
            data-cm-cal-open
            class="btn w-full max-w-60 cursor-pointer"
            style="background: var(--color-paper); color: var(--color-ink)"
          >
            Load Calendar
          </button>
        </div>
      </div>
    </div>
  </div>
</span>

<style>
  @media (max-width: 767px) {
    [data-cm-left].cm-hidden-mobile {
      display: none;
    }
  }
</style>
