---
import ContactModal from "./ContactModal.astro";
---

<section id="contact" class="surface-inverted">
  <div class="px-[clamp(1.5rem,4vw,4rem)] py-20 lg:py-28">
    <div class="flex items-center gap-3 animate-fade-in-up [animation-delay:500ms]">
      <span class="relative flex h-2.5 w-2.5">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
          style="background: var(--color-status-live)"
        ></span>
        <span
          class="relative inline-flex h-2.5 w-2.5 rounded-full"
          style="background: var(--color-status-live)"
        ></span>
      </span>
      <span class="stat-caption" style="color: var(--color-ink-surface-muted)">
        Available for new projects
      </span>
    </div>

    <h2
      class="mt-4 max-w-7xl animate-fade-in-up [animation-delay:200ms] md:text-8xl leading-tight"
      style="color: var(--color-ink-surface-text)"
    >
      Ready to fix or scale your{" "}
      <span class="accent">Shopify store?</span>
    </h2>

    <p class="body-lg mt-6 max-w-md animate-fade-in-up [animation-delay:300ms]">
      Stop losing sales to slow checkouts and fragile themes. Let&rsquo;s
      build something that converts.
    </p>

    <div class="mt-10 flex flex-col items-start gap-6 animate-fade-in-up [animation-delay:400ms] sm:flex-row sm:items-center">
      <ContactModal
        triggerText="Get a Shopify Audit"
        triggerStyle="btn btn-primary w-full sm:w-auto"
        title="Get your free Shopify audit."
        subtitle="Send your store and I'll tell you what to fix first. No pitch, no obligation."
        subject="Shopify Audit Request"
        fields={[
          { name: "name", label: "Name", type: "text", required: true },
          { name: "email", label: "Email", type: "email", required: true },
          {
            name: "website",
            label: "Store URL",
            type: "url",
            placeholder: "https://yourstore.com",
            required: true,
          },
          {
            name: "message",
            label: "What's going on?",
            type: "textarea",
            placeholder:
              "Slow checkout, buggy theme, scaling issues - what's the priority?",
            required: true,
          },
        ]}
        calTitle="Want to talk it through instead?"
        calSubtitle="Grab 15 minutes and we'll go over what I'd fix first."
        uid="cta"
      />
    </div>
  </div>
</section>
